[66.364406, "o", "\u001b[3;24r\u001b[24;1H\n\u001b[1;38r\u001b[12;56H\u001b[32m\u001b[40m`\u001b[13d\b\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m@\u001b[16;20H\u001b(B\u001b[0;7m\u001b[31m\u001b[40mg\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m .\u001b[21;30H  \u001b[38;5;17m\u001b[40mM\r\u001b[24d\u001b(0\u001b[0m\u001b[39;49m\u001b[37m\u001b[40mx\u001b(B\u001b[39;49m\u001b[37m\u001b[40m\u001b[24;16H\u001b(0\u001b[0m\u001b[39;49m\u001b[37m\u001b[40m\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m # # # # # # # # # # # # # #\u001b[24;64H# # \u001b[32m\u001b[40m.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m,\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m,\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m`\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m,\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m`\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m,\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m,\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m`\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m,\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m`\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[32m\u001b[40m,\u001b[110G\u001b(0\u001b[0m\u001b[39;49m\u001b[37m\u001b[40mx\u001b(B\u001b[39;49m\u001b[37m\u001b[40m\u001b[30;8H\u001b(0\u001b[0m\u001b[39;49m\u001b[37m\u001b[40m\u001b(B\u001b[39;49m\u001b[37m\u001b[40m"]

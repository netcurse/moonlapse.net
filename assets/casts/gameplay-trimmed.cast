[99.02372, "o", "\u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m # #   # # \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m . . . . . . . . . . . . . . . . \u001b[38;5;73mo\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[16;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[16;16H\u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;185mF\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m . . . . . . . . . . . . . . . . . . . \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[17;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[17;16H"]
[99.023743, "o", "\u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;73mo\u001b[39m\u001b(B\u001b[m . . . . . . . . . . . . . . . . . . \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[18;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[18;16H\u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m . . . . . . . . . . . . . . . . . . \u001b[38;5;238mo\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[19;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[19;16H"]
[99.023769, "o", "\u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m . . . . . . . . . . . . . . . . . . . . . \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[20;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[20;16H"]
[99.023788, "o", "\u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m . . . . . . . . . . . . . . . . . . . \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[21;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[21;16H\u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m . . . . . . . . . . . . . . . . . . \u001b[38;5;73mo\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[22;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[22;16H"]
[99.023811, "o", "\u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m . . . . . . . . . . . . . . . . . . . \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[23;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[23;16H"]
[99.023826, "o", "\u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m . . . . . . . . . . . . . . . . . \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[24;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[24;16H"]
[99.023846, "o", "\u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m . . . . . . . . . . . . . . o \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\r\u001b[25d"]
[99.023866, "o", "\u001b[39m\u001b(B\u001b[m\u250c\u2500\u001b(B\u001b[0;1;7m\u001b[38;5;176m You \u001b[39m\u001b(B\u001b[m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u250c\u2500\u001b(B\u001b[0;1;7m\u001b[38;5;176m Target \u001b[39m\u001b(B\u001b[m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[26;2H \u001b(B\u001b[0;1m\u001b[38;5;176mCorwen\u001b[39m\u001b(B\u001b[m\u001b[19X\u001b[26;28Hcb 29 \u2502\u2502 [ENTER] Mine Copper ore\u001b[16X\u001b[26;76H\u2502\u2502 \u001b(B\u001b[0;2mNo target\u001b(B\u001b[m    \u001b[27;2H HP \u001b(B\u001b[0;7m\u001b[38;5;71m                     \u001b[39m\u001b(B\u001b[m 38/38 \u2502\u2502\u001b[40X\u001b[27;76H"]

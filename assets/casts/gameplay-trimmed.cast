   \u2502\u001b[21;1H\u001b[0m\u2502              \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;180m.\u001b[39m \u001b[38;5;180m.\u001b[39m . . . . . . . . . . . . . . . . . . \u001b[38;5;73mo\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m             \u2502\u001b[22;1H\u001b[0m\u2502              \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;180m.\u001b[39m \u001b[38;5;180m.\u001b[39m \u001b[38;5;180m.\u001b[39m \u001b[38;5;180m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m . . . . . . . . . . . . . . . . . . . \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m             \u2502\u001b[23;1H\u001b[0m\u2502              \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;180m.\u001b[39m \u001b[38;5;180m.\u001b[39m \u001b[38;5;180m.\u001b[39m \u001b[38;5;180m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m . . . . . . . . . . . . . . . . . \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[3
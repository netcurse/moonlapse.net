[29.20451, "o", "\u001b[?25l\u001b[0m\u001b[2J\u001b[1;1H\u001b[0m                                              Springbud 02 4e1023 11:15 | \ud83c\udf13 First Quarter | Weather: overcast\u001b[2;1H\u001b[0m\u250c\u2500\u001b[1;7m\u001b[38;5;176m The Duskway Inn \u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[3;1H\u001b[0m\u2502              \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m . . . . . \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m             \u2502\u001b[4;1H\u001b[0m\u2502              \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;185mr\u001b[39m \u001b[38;5;71m.\u001b[39m             \u2502\u001b[5;1H\u001b[0m\u2502              \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;180mh\u001b[39m \u001b[38;5;180mn\u001b[39m \u001b[38;5;180mh\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;180mh\u001b[39m \u001b[38;5;180mn\u001b[39m \u001b[38;5;180mh\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m             \u2502\u001b[6;1H\u001b[0m\u2502              # # # # # # # # \u001b[38;5;71m,\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m # # # # # #   # # # # # # # # \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m             \u2502\u001b[7;1H\u001b[0m\u2502              #         =   # \u001b[38;5;71m`\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m #                     \u001b[38;5;180mh\u001b[39m   \u001b[38;5;167m^\u001b[39m # \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m             \u2502\u001b[8;1H\u001b[0m\u2502              #         =   # \u001b[38;5;71m.\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m #   \u001b[38;5;180mh\u001b[39m \u001b[38;5;180mn\u001b[39m \u001b[38;5;180mh\u001b[39m     \u001b[38;5;180mh\u001b[39m \u001b[38;5;180mn\u001b[39m \u001b[38;5;180mh\u001b[39m         # \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b
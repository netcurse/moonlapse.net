[2.52132, "o", "\u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[19;20H"]

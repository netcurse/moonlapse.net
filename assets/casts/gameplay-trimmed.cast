[99.023579, "o", "\u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[4;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[4;16H\u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[5;2H\u001b[39m\u001b(B\u001b[m\u001b[14X\u001b[5;16H\u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;29m&\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u00
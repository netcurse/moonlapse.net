[2.521168, "o", "\u001b[3;16H\u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m #\u001b[3;50H=\u001b[3;66H\u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[4;16H,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u00
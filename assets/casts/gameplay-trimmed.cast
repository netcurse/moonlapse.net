[1.160653, "o", "\u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[19;22H\u001b[39m\u001b(B\u001b[m \u001b[19;32H# \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[20;32H\u001b[39m\u001b(B\u001b[m# # # \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[21;32H\u001b[38;5;185m}\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m0\u001b[39m\u001b(B\u001b[m # \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u
39m \u001b[38;5;73mo\u001b[39m . . o . . \u001b[38;5;238mo\u001b[39m . . \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m             \u2502\u001b[13;1H\u001b[0m\u2502              \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;29m&\u001b[39m #       # \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m . . @ . . . . . . . . o . \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m             \u2502\u001b[14;1H\u001b[0m\u2502              \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m #       # \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;238mo\u001b[39m . . . . . . . . . . . . . . \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m             \u2502\u001b[15;1H\u001b[0m\u2502              \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\
[85.372748, "o", "\u001b[?25l\u001b[0m\u001b[2J\u001b[1;1H\u001b[0m                                                 Springbud 02 4e1023 11:49 | \ud83c\udf13 First Quarter | Weather: clear\u001b[2;1H\u001b[0m\u250c\u2500\u001b[1;7m\u001b[38;5;176m Redhill Mine \u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[3;1H\u001b[0m\u2502              \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m             \u2502\u001b[4;1H\u001b[0m\u2502              \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m             \u2502\u001b[5;1H\u001b[0m\u2502              \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u
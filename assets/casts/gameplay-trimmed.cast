[49.217413, "o", "\u001b[?25l\u001b[0m\u001b[2J\u001b[1;1H\u001b[0m                                                 Springbud 02 4e1023 11:29 | \ud83c\udf13 First Quarter | Weather: clear\u001b[2;1H\u001b[0m\u250c\u2500\u001b[1;7m\u001b[38;5;176m The Far Bank \u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[3;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m             \u2502\u001b[4;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m             \u2502\u001b[5;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m             \u2502\u001b[6;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m             \u2502\u001b[7;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m             \u2502\u001b[8;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m             \u2502\u001b[9;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m             \u2502\u001b[10;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m             \u2502\u001b[11;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m             \u2502\u001b[12;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m             \u2502\u001b[13;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m @ \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m.\u001b[39m             \u2502\u001b[14;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m,\u001b[39m             \u2502\u001b[15;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[7m\u001b[38;5;167mb\u001b[0m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m,\u001b[39m             \u2502\u001b[16;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m`\u001b[39m             \u2502\u001b[17;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m             \u2502\u001b[18;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m             \u2502\u001b[19;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;29m&\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m             \u2502\u001b[20;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m             \u2502\u001b[21;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m             \u2502\u001b[22;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m             \u2502\u001b[23;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m             \u2502\u001b[24;1H\u001b[0m\u2502                              \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;244m^\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68m~\u001b[39m \u001b[38;5;68mf\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m             \u2502\u001b[25;1H\u001b[0m\u250c\u2500\u001b[1;7m\u001b[38;5;176m You \u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u250c\u2500\u001b[1;7m\u001b[38;5;176m Target \u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[26;1H\u001b[0m\u2502 \u001b[1m\u001b[38;5;176mCorwen\u001b[0m                   cb 29 \u2502\u2502                                        \u2502\u2502 \u001b[1m\u001b[38;5;167mBear\u001b[0m                     cb 25 \u2502\u001b[27;1H\u001b[0m\u2502 HP \u001b[7m\u001b[38;5;71m                     \u001b[0m 38/38 \u2502\u2502                                        \u2502\u2502 HP \u001b[7m\u001b[38;5;71m                     \u001b[0m 55/55 \u2502\u001b[28;1H\u001b[0m\u2502 \u001b[2mSlash\u001b[0m                     [AR] \u2502\u2502                                        \u2502\u2502 \u001b[2m[a] attack  [w] walk to\u001b[0m        \u2502\u001b[29;1H\u001b[0m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[1m\u001b[38;5;176m Heavy-handed 2 8:40 \u001b[0m\u2500\u2518\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2
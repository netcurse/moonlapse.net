01b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;244mY\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m             \u2502\u001b[23;1H\u001b[0m\u2502              \u001b[38;5;71m,\u001b[39m # # # # # # \u001b[38;5;71m,\u001b[39m # #   # # \u001b[38;5;71m,\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m # # # # # \u001b[38;5;71m,\u001b[39m # # # # # # \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m             \u2502\u001b[24;1H\u001b[0m\u2502              \u001b[38;5;71m,\u001b[39m #     = = # \u001b[38;5;71m.\u001b[39m #       # \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m,\u001b[39m # = =   # \u001b[38;5;71m,\u001b[39m # \u001b[38;5;185mR\u001b[39m       # \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m`\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;244m:\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m,\u001b[39m \u001b[38;5;71m.\u001b[39m \u001b[38;5;71m.\u001b[39m             \u2502\u001b[25;1H\u001b[0m\u250c\u2500\u001b[1;7m\u001b[38;5;176m You \u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2
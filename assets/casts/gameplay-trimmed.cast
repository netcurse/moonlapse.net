[1.160671, "o", "\u001b[39m\u001b(B\u001b[m# \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;231mF\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;180m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;244m^\u001b[23;28H\u001b[38;5;231mN\u001b[39m\u001b(B\u001b[m       # # \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m.\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m`\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u001b[39m\u001b(B\u001b[m \u001b[38;5;71m,\u0